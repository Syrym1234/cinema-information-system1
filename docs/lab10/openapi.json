    "/api/tables/{name}": {
      "get": {
        "summary": "Read every row and every column in one table",
        "operationId": "readTable",
        "description": "Read-only. No default row limit. Search, sorting, supported foreign keys and rating/price ranges are parameterized. Unknown query parameters return 400.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Genres",
                "Movies",
                "Halls",
                "Sessions",
                "Customers",
                "Tickets",
                "MenuItems"
              ]
            },
            "description": "Case-insensitive whitelist of the seven CinemaSchoolDB tables."
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Literal text search in text columns. Unsupported for Tickets."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "An actual column in this table; defaults to its primary key."
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            },
            "description": "Sort direction."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "description": "Optional; omitting it returns every row."
          },
          {
            "name": "genre_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "Exact foreign-key filter, only when that foreign key exists in this table."
          },
          {
            "name": "movie_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "Exact foreign-key filter, only when that foreign key exists in this table."
          },
          {
            "name": "hall_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "Exact foreign-key filter, only when that foreign key exists in this table."
          },
          {
            "name": "session_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "Exact foreign-key filter, only when that foreign key exists in this table."
          },
          {
            "name": "customer_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "description": "Exact foreign-key filter, only when that foreign key exists in this table."
          },
          {
            "name": "min_rating",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "multipleOf": 0.1
            },
            "description": "Movies only."
          },
          {
            "name": "max_rating",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10,
              "multipleOf": 0.1
            },
            "description": "Movies only."
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 99999999.99,
              "multipleOf": 0.01
            },
            "description": "Tables with a price column only."
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 99999999.99,
              "multipleOf": 0.01
            },
            "description": "Tables with a price column only."
          }
        ],
        "responses": {
          "200": {
            "description": "Full table or filtered rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TableGenres"
                      },
                      {
                        "$ref": "#/components/schemas/TableMovies"
                      },
                      {
                        "$ref": "#/components/schemas/TableHalls"
                      },
                      {
                        "$ref": "#/components/schemas/TableSessions"
                      },
                      {
                        "$ref": "#/components/schemas/TableCustomers"
                      },
                      {
                        "$ref": "#/components/schemas/TableTickets"
                      },
                      {
                        "$ref": "#/components/schemas/TableMenuItems"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
