{
  "openapi": "3.0.3",
  "info": {
    "title": "Cinema Lab 10 REST API",
    "version": "1.1.0",
    "description": "Educational local CRUD API using Node.js, Express and Microsoft SQL Server. Existing cinema domain retained from Labs 6–9. No authentication: bind to loopback for this lab. Request body limit: 16 KB."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/movies": {
      "get": {
        "summary": "List movies ordered by rating, title, ID",
        "operationId": "listMovies",
        "responses": {
          "200": {
            "description": "Movies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MovieRead"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed (Allow header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a movie",
        "operationId": "createMovie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              },
              "example": {
                "title": "Lab10 | Қазақша фильм",
                "genre_id": 1,
                "duration_min": 110,
                "age_rating": 12,
                "release_year": 2026,
                "rating": 8.5,
                "description": "REST API арқылы қосылған уақытша оқу фильмі."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created movie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative URL of the created movie"
              }
            }
          },
          "400": {
            "description": "Validation error / invalid ID or JSON / genre missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds 16 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed (Allow header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "Allowed methods",
        "responses": {
          "204": {
            "description": "No content; Allow header lists supported methods"
          }
        }
      }
    },
    "/api/movies/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "summary": "Read one movie",
        "operationId": "getMovie",
        "responses": {
          "200": {
            "description": "Movie with genre",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieRead"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / invalid ID or JSON / genre missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed (Allow header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace every writable field (full PUT)",
        "operationId": "updateMovie",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovieInput"
              },
              "example": {
                "title": "Lab10 | Қазақша фильм",
                "genre_id": 1,
                "duration_min": 110,
                "age_rating": 12,
                "release_year": 2026,
                "rating": 8.5,
                "description": "REST API арқылы қосылған уақытша оқу фильмі."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated movie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / invalid ID or JSON / genre missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds 16 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed (Allow header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a movie with no sessions",
        "operationId": "deleteMovie",
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "movie_id"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "movie_id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error / invalid ID or JSON / genre missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Movie has sessions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed (Allow header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "Allowed methods",
        "responses": {
          "204": {
            "description": "No content; Allow header lists supported methods"
          }
        }
      }
    },
    "/api/metadata": {
      "get": {
        "summary": "Genre and hall choices",
        "operationId": "getMetadata",
        "responses": {
          "200": {
            "description": "Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "genres",
                    "halls"
                  ],
                  "properties": {
                    "genres": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "genre_id",
                          "genre_name"
                        ],
                        "properties": {
                          "genre_id": {
                            "type": "integer"
                          },
                          "genre_name": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "halls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "hall_id",
                          "hall_name"
                        ],
                        "properties": {
                          "hall_id": {
                            "type": "integer"
                          },
                          "hall_name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Database connectivity check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Database is reachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "db_name",
                    "movies"
                  ],
                  "properties": {
                    "db_name": {
                      "type": "string"
                    },
                    "movies": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MovieInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "genre_id",
          "duration_min",
          "age_rating",
          "release_year",
          "rating",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "\\S"
          },
          "genre_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "duration_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "age_rating": {
            "type": "integer",
            "enum": [
              0,
              6,
              12,
              16,
              18,
              21
            ]
          },
          "release_year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "multipleOf": 0.1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      },
      "Movie": {
        "type": "object",
        "required": [
          "movie_id",
          "title",
          "genre_id",
          "duration_min",
          "age_rating",
          "release_year",
          "rating",
          "description"
        ],
        "properties": {
          "movie_id": {
            "type": "integer",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "\\S"
          },
          "genre_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "duration_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "age_rating": {
            "type": "integer",
            "enum": [
              0,
              6,
              12,
              16,
              18,
              21
            ]
          },
          "release_year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "multipleOf": 0.1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      },
      "MovieRead": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Movie"
          },
          {
            "type": "object",
            "required": [
              "genre_name"
            ],
            "properties": {
              "genre_name": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
