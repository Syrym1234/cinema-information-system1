                "age_rating": 12,
                "release_year": 2026,
                "rating": 8.5,
                "description": "REST API арқылы қосылған уақытша оқу фильмі."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated movie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Movie"
                }
              }
            }
          },
          "400": {
            "description": "Validation error / invalid ID or JSON / genre missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Movie not found",
            "content": {
