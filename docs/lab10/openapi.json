                      "$ref": "#/components/schemas/TableMovies"
                    },
                    {
                      "$ref": "#/components/schemas/TableHalls"
                    },
                    {
                      "$ref": "#/components/schemas/TableSessions"
                    },
                    {
                      "$ref": "#/components/schemas/TableCustomers"
                    },
