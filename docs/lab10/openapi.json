                      "$ref": "#/components/schemas/TableTickets"
                    },
                    {
                      "$ref": "#/components/schemas/TableMenuItems"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Invalid query, ID, or unavailable resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MovieInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "genre_id",
          "duration_min",
          "age_rating",
          "release_year",
          "rating",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "\\S"
          },
          "genre_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "duration_min": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "age_rating": {
            "type": "integer",
            "enum": [
              0,
              6,
              12,
              16,
              18,
              21
            ]
          },
          "release_year": {
            "type": "integer",
            "minimum": 1888,
            "maximum": 2100
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "multipleOf": 0.1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      },
      "Movie": {
        "type": "object",
        "required": [
          "movie_id",
          "title",
          "genre_id",
