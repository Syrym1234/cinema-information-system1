      "name": "01 Барлық жеті кесте",
      "item": [
        {
          "name": "00 Барлық кестелер және жолдар саны",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON response', () => pm.response.to.be.json);",
                  "const rows=pm.response.json();pm.test('Seven tables',()=>pm.expect(rows.length).to.eql(7));",
                  "pm.collectionVariables.set('tableCounts',JSON.stringify(Object.fromEntries(rows.map(r=>[r.table,r.row_count]))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Genres | барлық жолдар",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tables/Genres"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON response', () => pm.response.to.be.json);",
                  "const rows=pm.response.json();",
                  "pm.test('Full table row count',()=>pm.expect(rows.length).to.eql(JSON.parse(pm.collectionVariables.get('tableCounts'))['Genres']));",
                  "pm.test('All table columns',()=>rows.forEach(row=>pm.expect(Object.keys(row).sort()).to.eql([\"genre_id\",\"genre_name\"])));",
                  "pm.collectionVariables.set('genre_id',rows.length ? rows[0].genre_id : 1);"
                ]
              }
            }
          ]
        },
