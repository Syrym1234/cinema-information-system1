    {
      "name": "02 Сүзу және қате сұраныстар",
      "item": [
        {
          "name": "Фильмдер | рейтинг >= 8, кему реті",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tables/Movies?min_rating=8&sort=rating&order=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON response', () => pm.response.to.be.json);",
                  "const rows=pm.response.json();pm.test('Rating filter and order',()=>{pm.expect(rows.length).to.be.above(0);rows.forEach((r,i)=>{pm.expect(r.rating).to.be.at.least(8);if(i)pm.expect(rows[i-1].rating).to.be.at.least(r.rating);});});"
                ]
              }
            }
          ]
        },
