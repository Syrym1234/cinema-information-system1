# Көшіріп .env деп атаңыз. SQL Server атауын SSMS-тағыдай көрсетіңіз.
DB_SERVER=localhost
DB_NAME=CinemaSchoolDB
DB_AUTH=sql
DB_USER=sa
DB_PASSWORD=your_sql_server_password
DB_PORT=1433
DB_TRUST_CERT=true
DB_ENCRYPT=false
HOST=127.0.0.1
PORT=3000

# Windows Authentication (SQL Express):
# DB_AUTH=windows
# DB_SERVER=.\SQLEXPRESS
# Named instance: remove DB_PORT above so SQL Browser can resolve its port.
# npm install includes the optional msnodesqlv8 driver on Windows.
